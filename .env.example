# Kopiuj do .env.local (gitignore) i wypełnij realnymi wartościami — nigdy do .env/repo.
# docs/standards/18-logowanie.md, 18.4: Supabase Auth jako wymóg dla całej rodziny aplikacji.
# Ten projekt ma WŁASNY, niezależny projekt Supabase (18.15 — appki rodziny nigdy nie dzielą
# jednego backendu, transfer danych między nimi idzie przez eksport/import pliku, nie żywe
# połączenie baz).
#
# Skąd wziąć wartości: supabase.com → New Project → Settings → API.
# NEXT_PUBLIC_* jest bezpieczne w kliencie — "anon key" nie jest sekretem, dostęp do danych
# kontroluje RLS (docs/standards/06-api-i-siec.md, 6.5), nie tajność tego klucza.

NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-key

# 18.8 (usuwanie konta) — Admin API, omija RLS. NIGDY prefiksu NEXT_PUBLIC_ (musi zostać
# server-only — trafienie do bundla klienckiego dałoby pełny dostęp administracyjny każdemu
# odwiedzającemu). Skąd wziąć: supabase.com → Settings → API → "service_role" (sekcja "Project API keys",
# nie "anon public"). Brak tej wartości nie blokuje reszty logowania — tylko funkcję usuwania konta.
SUPABASE_SERVICE_ROLE_KEY=twoj-service-role-key
